<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />
    <!--
        WRITE_SECURE_SETTINGS cannot be granted at install-time by users;
        it must be granted once via ADB:
            adb shell pm grant dev.holz.nfcwidget android.permission.WRITE_SECURE_SETTINGS
        Without it, tapping the widget opens the NFC settings page instead.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_nfc_on"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- AppWidgetProvider: updates widget UI on APPWIDGET_UPDATE -->
        <receiver
            android:name=".NfcToggleWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nfc_widget_info" />
        </receiver>

        <!-- Handles widget tap and NFC state change broadcasts.
             exported=true is required to receive the system NFC adapter state broadcast. -->
        <receiver
            android:name=".WidgetClickReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.holz.nfcwidget.TOGGLE_NFC" />
                <action android:name="android.nfc.action.ADAPTER_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
